# Nothing in this tree ever holds a real key. The app reads these names from the environment;
# run.sh and listen.sh export them from a SOPS-encrypted env file (see README). This file only
# documents the names.
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
BILLING_DB=billing.db
BILLING_BASE_URL=http://localhost:8400
# Optional: where the price catalogue lives (default: prices.json next to app.py)
BILLING_PRICES_FILE=
